[user]
	name = James-Steve
	email = 66531058+James-Steve@users.noreply.github.com
[alias]
    lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
    lg = !"git lg1"
    st = status
    ls-ignored = ls-files .  --ignored --exclude-standard --others
    ls-untracked = ls-files .  --exclude-standard --others
    ls-tracked = ls-tree --full-tree --name-only -r HEAD
    untrack-ignored-files = !git rm -r --cached . && git add -A && git commit -am "Remove ignored files" 
    ch=checkout
    search= "!f(){ git grep \"$1\" $(git rev-list --all) ; }; f"


#helpfull commands
#git checkout --track origin/branchname     will start tracking an already existing remote branch
#git ls-files . --ignored --exclude-standard --others    will list ignored files
#git ls-files . --exclude-standard --others             will list untracked files
[core]
	editor = nvim
	excludesfiles = /home/jim/.gitignore_global
	excludesfile = /home/jim/.gitignore_global
[safe]
	directory = /home/jim/Documents/Source/neovim/
	directory = /home/rob/Documents/Linux-Dotfiles-2023/dotfiles/dotconfig/nvim
	directory = /home/rob/Documents/Linux-Dotfiles-2023/dotfiles/dotdocuments/Source/Suckless-Software
[merge]
  tool = vimdiff
[mergetool]
  prompt = true
[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[difftool]
  prompt = true
[diff]
  tool = vimdiff
